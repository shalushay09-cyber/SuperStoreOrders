SELECT COUNT(*) FROM store;
--51 Какие подкатегории показывают рост продаж от года к году?
WITH yearly AS ( SELECT sub_category, year, SUM(sales) AS "Продажи" FROM store GROUP BY sub_category, year),
lagger AS (SELECT sub_category, year, "Продажи", LAG ("Продажи") OVER(PARTITION BY sub_category ORDER BY year) AS "prev" FROM yearly)
SELECT sub_category, year, "Продажи", "prev", "Продажи" - "prev" AS "разница" FROM lagger WHERE "prev" IS NOT NULL AND "Продажи" > "prev";
--52 Какие товары покупают только клиенты из сегмента "Corporate"?
