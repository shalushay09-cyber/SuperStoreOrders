--XIII. Сравнительный Анализ
--119 Сравнить продажи "Office Supplies" в США и Канаде.
SELECT country, ROUND(SUM(sales)) FROM store WHERE (country = 'United States' OR country = 'Canada') AND category = 'Office Supplies' GROUP BY country;
SELECT * FROM store;
--120 Сравнить эффективность (среднюю прибыль) "Corporate" и "Consumer" сегментов в Европе
SELECT segment, AVG(profit) FROM store WHERE market = 'EU' AND (segment = 'Corporate' OR segment = 'Consumer') GROUP BY segment;
--121 Сравнить среднюю скидку для товаров с высокой и низкой прибылью
SELECT CASE WHEN profit < (SELECT AVG(profit) FROM store) THEN 'low'
WHEN profit > (SELECT AVG(profit) FROM store) THEN 'high' END AS type, AVG(discount) FROM store GROUP BY type;
--122 Сравнить общую прибыль от "Furniture" в 2011 и 2012 годах.
SELECT year, SUM(profit) FROM store WHERE category = 'Furniture' AND (year=2011 OR year=2012) GROUP BY year;
--123 Сравнить количество заказов в "Standard Class" и "Second Class" по месяцам
SELECT TO_CHAR (order_date, 'Month') AS "Month", ship_mode, COUNT (*) FROM store WHERE ship_mode = 'Standard Class' OR ship_mode = 'Second Class' GROUP BY "Month", ship_mode ORDER BY "Month";
--XIV. Аномалии и Выбросы
--124 Заказы с аномально высокой стоимостью доставки (Shipping Cost > 1000)
SELECT * FROM store WHERE shipping_cost > 1000;
--125 Заказы с очень высокой скидкой (Discount > 0.9)
SELECT * FROM store WHERE discount > 0.9;
--126 Найти заказы с положительной Sales и отрицательной Profit при Discount = 0. (Проверить на ошибки в данных)
SELECT * FROM store WHERE sales > 0 AND profit < 0 AND discount = 0;
--127 Клиенты, которые сделали только один заказ, но с очень большой суммой
SELECT customer_name FROM store GROUP BY customer_name HAVING (COUNT (*) = 1) AND (AVG(sales) > (SELECT AVG(sales) FROM store));
--128 Найти подкатегории с сильно различающейся маржинальностью.
WITH mrg AS (SELECT sub_category, (profit/NULLIF (sales, 0) * 100) AS margin FROM store WHERE sales > 1)
SELECT sub_category, ROUND(AVG(margin)) AVG , ROUND(STDDEV(margin)) STDDEV, ROUND(MAX(margin)-MIN(margin)) AS размах FROM mrg GROUP BY sub_category;
--129 Товары с необычно низкой ценой для своей категории.
WITH virok_1 AS (SELECT category, product_name, (sales/quantity) AS price FROM store),
virok_2 AS (SELECT *, AVG(price) OVER (PARTITION BY category) AS price2 FROM virok_1)
SELECT product_name FROM virok_2 WHERE price < price2 /2;
--XV. Комбинированные и Сложные Запросы
--130 Клиенты, которые купили товары из всех трех категорий (Furniture, Office Supplies, Technology).
SELECT customer_name FROM store GROUP BY customer_name HAVING COUNT(DISTINCT(category)) = 3;
--131 Заказы, где сумма скидки превышает стоимость доставки (Discount > Shipping Cost)
SELECT * FROM store WHERE (sales * discount > shipping_cost);
--132 Для каждого клиента найти его самый прибыльный и самый убыточный заказ.
SELECT customer_name, MAX(profit), MIN(profit) FROM store GROUP BY customer_name ORDER BY customer_name;
--133 Найти товары, которые продаются лучше всего в тех странах, где они же приносят наибольшую прибыль
WITH virok1 AS (SELECT product_name, country, SUM(profit) AS prof, SUM(sales) AS sal FROM store GROUP BY product_name, country), 
virok2 AS (SELECT *, RANK() OVER(PARTITION BY product_name ORDER BY sal DESC) AS rnk_sales, RANK() OVER(PARTITION BY product_name ORDER BY prof DESC) AS rnk_profit FROM virok1)
SELECT product_name, country FROM virok2 WHERE rnk_sales = 1 AND rnk_profit = 1;
--134 Рассчитать долю каждой подкатегории в общей прибыли своей категории
SELECT category, sub_category, SUM(profit) AS prf, ROUND(SUM(profit) * 100.00/SUM(SUM(profit)) OVER (PARTITION BY category), 2) AS prcnt FROM store GROUP BY category, sub_category;
--135 Определить, какие товары чаще всего покупают вместе (например, в одном заказе) 
SELECT a.product_name AS product1, b.product_name AS product2, COUNT(*) FROM store a JOIN store b ON a.order_id = b.order_id AND a.product_name < b.product_name 
GROUP BY a.product_name, b.product_name ORDER BY count DESC LIMIT 30;
--136 Найти клиентов, которые сменили сегмент (если такое возможно в данных)
SELECT customer_name, COUNT(DISTINCT (segment)) FROM store GROUP BY customer_name HAVING COUNT(DISTINCT (segment)) > 1;
-- 137 Рассчитать скользящую среднюю продаж за последние 3 месяца.
WITH virok AS (SELECT DATE_TRUNC('month', order_date) AS month, SUM(sales) FROM store GROUP BY month)
SELECT month, sum, ROUND(AVG(sum) OVER (ORDER BY month ROWS BETWEEN 2 PRECEDING AND CURRENT ROW), 2) as avg
FROM virok ORDER BY month;
-- 138 Предложить список товаров, на которые стоит повысить цену (высокий спрос, высокая маржа)
WITH virok1 AS (SELECT product_name, category, SUM(profit) AS profits, SUM(sales) AS saless, SUM(quantity) AS quantitys FROM STORE group by product_name, category),
virok2 AS (SELECT *, profits *100.0/ (NULLIF (saless, 0)) AS marga, AVG(quantitys) OVER (PARTITION BY category) AS quant_avg FROM virok1)
SELECT product_name, quantitys, marga FROM virok2 WHERE quantitys > quant_avg AND marga > 20; 
--139 Предложить список товаров, на которые стоит дать скидку (чтобы распродать)
WITH virok1 AS (SELECT product_name, category, SUM(profit) AS profits, SUM(sales) AS saless, SUM(quantity) AS quantitys FROM STORE group by product_name, category),
virok2 AS (SELECT *, profits *100.0/ (NULLIF (saless, 0)) AS marga, AVG(quantitys) OVER (PARTITION BY category) AS quant_avg FROM virok1)
SELECT product_name, quantitys, marga FROM virok2 WHERE quantitys < quant_avg AND marga < 10; 
-- 140 В каких странах стоит открыть новый склад (высокие продажи, высокие затраты на доставку)?
SELECT * FROM store;
WITH virok AS (SELECT country, SUM(sales) AS saless, SUM(shipping_cost) scs FROM store GROUP BY country),
virok2 AS (SELECT *, AVG(saless) OVER () AS avg_sal, AVG(scs) OVER () AS avg_scs FROM virok)
SELECT country FROM virok2 WHERE saless> avg_sal AND scs > avg_scs;
--141 Какой сегмент клиентов наиболее лоялен и приносит больше всего прибыли?
SELECT segment, COUNT(DISTINCT customer_name) AS distin, COUNT(*), COUNT(*) * 1.00 / COUNT(DISTINCT customer_name) AS count_for_1, SUM(profit) FROM store GROUP BY segment;
--142 На сколько нужно увеличить продажи в самом убыточном регионе, чтобы выйти в ноль?
SELECT region, SUM(profit) FROM store GROUP BY region; --нет убыточных
--143 Какие категории товаров требуют большего маркетингового внимания (низкие продажи, но высокий потенциал)?
WITH virok AS (SELECT category, SUM(sales), SUM(profit) * 100.0/ SUM(NULLIF(sales, 0)) AS marga FROM store GROUP BY category),
virok2 AS (SELECT *, AVG(sum) OVER(), AVG (marga) OVER() as mar FROM virok)
SELECT category FROM virok2 WHERE sum < avg AND marga > mar;
--144 Оценить влияние скидок на общую прибыль компании
SELECT CORR(discount, profit) FROM store;
SELECT SUM(profit) AS sum_with_no_discount, COUNT(*) AS count_with_no_discount FROM store WHERE discount = 0
UNION ALL
SELECT SUM(profit) AS sum_with_discount, COUNT(*) AS count_with_discount FROM store WHERE discount > 0;
SELECT CASE 
	WHEN discount = 0 THEN 'Скидка нема'
	WHEN discount <= 0.1 THEN 'Скидка 1-10%'
    WHEN discount <= 0.2 THEN 'Скидка 11-20%'
    WHEN discount <= 0.3 THEN 'Скидка 21-30%'
    WHEN discount <= 0.4 THEN 'Скидка 31-40%'
    WHEN discount <= 0.5 THEN 'Скидка 41-50%'
    WHEN discount <= 0.6 THEN 'Скидка 51-60%'
    WHEN discount <= 0.7 THEN 'Скидка 61-70%'
    WHEN discount <= 0.8 THEN 'Скидка 71-80%'
    WHEN discount <= 0.9 THEN 'Скидка 81-90%'
    WHEN discount <= 1 THEN 'Скидка 91-100%'
    ELSE 'Другое' END AS "Classification",
    SUM(profit) AS sum_of_pr, AVG(profit) AS avg_of_pr, COUNT(*) FROM store GROUP BY "Classification" ORDER BY "Classification";
--145 Спрогнозировать продажи на следующий месяц на основе исторических данных.
WITH virok AS (SELECT date_trunc('month', order_date) AS month_start, SUM(sales) AS sales FROM store GROUP BY date_trunc('month', order_date)),
virok1 AS (SELECT month_start, AVG(sales) OVER (ORDER BY month_start ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS rolling_3m FROM virok)
SELECT (MAX(month_start) + INTERVAL '1 month') AS forecast_month, MAX(rolling_3m) AS forecast_sales FROM virok1;
