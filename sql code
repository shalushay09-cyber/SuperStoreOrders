WITH profit_top_10 AS (SELECT product_name, ROUND(SUM(profit)) AS "Профит на товар" FROM store GROUP BY product_name ORDER BY "Профит на товар" DESC 
LIMIT (SELECT COUNT(DISTINCT(product_name))*10/100 FROM store)),
sum_of_profit_top_10 AS (SELECT ROUND(SUM("Профит на товар")) AS "Весь профит на топ 10" FROM profit_top_10)
