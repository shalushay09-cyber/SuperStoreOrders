--86 В какой категории товаров чаще всего используют "Standard Class"?
SELECT category, COUNT (*) FROM store WHERE ship_mode = 'Standard Class' GROUP BY category ORDER BY count DESC LIMIT 1;
--87 Зависит ли выбор доставки от сезона (месяца)?
SELECT * FROM (SELECT TO_CHAR(order_date, 'Month') as Month, ship_mode, COUNT (*) AS count, ROUND(COUNT(*) * 100.0 / SUM (COUNT(*)) OVER (PARTITION BY TO_CHAR(order_date, 'Month')), 1) AS prcnt, 
RANK () OVER (PARTITION BY TO_CHAR(order_date, 'Month') ORDER BY COUNT (*) DESC) AS rank
FROM store GROUP BY Month, ship_mode) WHERE rank = 1;
