-- XIX. Продуктовые "Корзины"
--156 Какие товары часто покупаются вместе с "Xerox195"?
WITH virok1 AS (SELECT DISTINCT order_id FROM store WHERE product_name = 'Xerox 195')
SELECT s.product_name, COUNT (s.order_id) FROM store s JOIN virok1 v ON s.order_id=v.order_id GROUP BY s.product_name;
--157 Какие подкатегории чаще всего встречаются в одном заказе?
SELECT a.sub_category AS sub1, b.sub_category AS sub2, COUNT(DISTINCT a.order_id) AS times_together
FROM (SELECT DISTINCT order_id, sub_category FROM store) a JOIN (SELECT DISTINCT order_id, sub_category FROM store) b
 ON a.order_id = b.order_id AND a.sub_category < b.sub_category GROUP BY a.sub_category, b.sub_category ORDER BY times_together DESC;
--158 Создать список топ-10 пар товаров, которые покупают вместе.
SELECT a.product_name AS pr1, b.product_name AS pr2, COUNT(DISTINCT a.order_id) AS times_together
FROM (SELECT DISTINCT order_id, product_name FROM store) a JOIN (SELECT DISTINCT order_id, product_name FROM store) b
 ON a.order_id = b.order_id AND a.product_name < b.product_name GROUP BY a.product_name, b.product_name ORDER BY times_together DESC;
--159 Рассчитать среднее время доставки (ship_date - order_date) для каждого способа доставки
SELECT ship_mode, AVG(ship_date-order_date ) FROM store GROUP BY ship_mode ORDER BY avg DESC;
--160 Зависит ли время доставки от географического региона?
SELECT region, AVG(ship_date-order_date ) FROM store GROUP BY region ORDER BY avg DESC;
--161 Есть ли корреляция между временем доставки и прибылью заказа?
SELECT CORR ((ship_date-order_date), profit) FROM store;
--162 В каких странах самое долгое время доставки?
SELECT country, AVG(ship_date-order_date) FROM store GROUP BY country ORDER BY avg DESC;
--163 Как приоритет заказа влияет на время доставки?
SELECT * FROM store;
SELECT order_priority, AVG(ship_date-order_date) FROM store GROUP BY order_priority ORDER BY avg DESC;
--164 Рассчитать Profit per Unit (Прибыль на единицу товара: Profit / Quantity) для каждого товара.
WITH virok AS (SELECT product_name, SUM(profit) AS sp, SUM(quantity) AS sqv FROM store GROUP BY product_name)
SELECT product_name, sp/sqv FROM virok;
--165 Топ-10 товаров с самым высоким Profit per Unit.
SELECT product_name, SUM(profit) / SUM(quantity) AS ppu FROM store GROUP BY product_name ORDER BY ppu DESC limit 10;
--166 Топ-10 товаров с самым низким Profit per Unit.
SELECT product_name, SUM(profit) / SUM(quantity) AS ppu FROM store GROUP BY product_name ORDER BY ppu limit 10;
--XXII. Анализ Возвратов (Приблизительный, через отрицательную прибыль)
--167 Какая подкатегория товаров имеет самый высокий "процент возвратов" (отрицательная прибыль в заказах)?
SELECT sub_category, SUM (CASE WHEN profit < 0 THEN 1 ELSE 0 END) / COUNT(*) as "prcnt_return" FROM store GROUP BY sub_category ORDER BY "prcnt_return" DESC;
--168 В каком месяце было больше всего "возвратов" (отрицательных заказов)?
SELECT TO_CHAR(order_date, 'Month') AS Month, COUNT(*) FROM store WHERE profit < 0 GROUP BY Month ORDER BY count DESC;
