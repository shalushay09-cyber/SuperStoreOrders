SELECT segment, ROUND(AVG(sales), 3) AS avg_sales, ROUND(AVG(quantity), 3) AS avg_quantity, ROUND(AVG(profit), 3) AS avg_profit FROM store GROUP BY segment;
--114 Суммарная Profit по каждой Category в разрезе Region.
